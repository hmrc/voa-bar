# microservice specific routes

POST        /login                          uk.gov.hmrc.vo.autobars.controllers.LoginController.login

POST        /upload                         uk.gov.hmrc.vo.autobars.controllers.UploadController.upload

POST        /upload/confirmation/:baLogin   uk.gov.hmrc.vo.autobars.controllers.UpscanCallbackController.onConfirmation(baLogin: String)

GET         /submissions                    uk.gov.hmrc.vo.autobars.controllers.SubmissionStatusController.getByUser(filter: Option[String])

GET         /submissions/all                uk.gov.hmrc.vo.autobars.controllers.SubmissionStatusController.getAll

PUT         /submissions                    uk.gov.hmrc.vo.autobars.controllers.SubmissionStatusController.save(upsert: Boolean)

GET         /submissions/:reference         uk.gov.hmrc.vo.autobars.controllers.SubmissionStatusController.getByReference(reference: String)
DELETE      /submissions/:reference         uk.gov.hmrc.vo.autobars.controllers.SubmissionStatusController.deleteByReference(reference: String)

PUT         /submissions/user-info          uk.gov.hmrc.vo.autobars.controllers.SubmissionStatusController.saveUserInfo

GET         /user-report-upload/:id         uk.gov.hmrc.vo.autobars.controllers.UserReportUploadsController.getById(id)

PUT         /user-report-upload             uk.gov.hmrc.vo.autobars.controllers.UserReportUploadsController.save

PUT         /validate-upload/:baLogin       uk.gov.hmrc.vo.autobars.controllers.ValidateController.validate(baLogin: String)
